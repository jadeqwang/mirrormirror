node_modules/
dist/
dist-server/
config.json
# Desk-rehearsal Chromium profiles (`npm run screens`). They hold the camera
# permission grant, which is the point — deleting them means granting again.
.chromium/

# Eval photographs are of identifiable people, and the wall label promises no
# visitor images are retained. Keep them out of the repo. See fixtures/eval/README.md.
fixtures/eval/images/*
!fixtures/eval/images/README.md

# Credentials. Never commit these; .env.example is the checked-in template.
# On the Pi they live in /etc/mirrormirror/server.env instead, outside the repo.
.env
.env.*
*.env
# Editor backups. gnome-text-editor and vim write `.env~` on save, which none
# of the patterns above match — it is a plain-text copy of the credentials.
*~
*.swp
!.env.example
